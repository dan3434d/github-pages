      /*---------------------------------------
       * Accordion Functionality
       ---------------------------------------*/
      faq.accordionHeaders.forEach(header => {
        header.addEventListener('click', () => {
          const isActive = header.parentElement.classList.contains('active');
          if (isActive) {
            header.parentElement.classList.remove('active');
            header.setAttribute('aria-expanded', 'false');
          } else {
            const currentlyActive = document.querySelector('.accordion-item.active');
            if (currentlyActive) {
              currentlyActive.classList.remove('active');
              currentlyActive.querySelector('.accordion-header').setAttribute('aria-expanded', 'false');
            }
            header.parentElement.classList.add('active');
            header.setAttribute('aria-expanded', 'true');
          }
        });

        header.addEventListener('keypress', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            header.click();
          }
        });
      });

      /*---------------------------------------
       * FAQ Search Functionality
       ---------------------------------------*/
      function filterFAQs(query) {
        let resultsFound = false;
        faq.accordionItems.forEach(item => {
          const question = item.querySelector('.accordion-header h3').textContent.toLowerCase();
          const answer = item.querySelector('.accordion-content p').textContent.toLowerCase();
          if (question.includes(query) || answer.includes(query)) {
            item.style.display = "block";
            resultsFound = true;
          } else {
            item.style.display = "none";
          }
        });

        if (resultsFound || query === "") {
          notifications.noResults.style.display = "none";
        } else {
          notifications.noResults.style.display = "block";
        }
      }

      // Since the search button is removed, implement real-time search as user types
      faq.searchInput.addEventListener('input', () => {
        const query = faq.searchInput.value.trim().toLowerCase();
        console.log('FAQ Search Query:', query);
        filterFAQs(query);
      });

      /*---------------------------------------
       * AI Suggestions via Webhook
       ---------------------------------------*/
      async function getAISuggestions(text) {
        try {
          const response = await fetch('https://hook.eu2.make.com/ewywfkxdjknd85h4sa5osrhg7ycf6xv5', {
            method: 'POST',
            headers: {
              'Content-Type': 'text/plain'
            },
            body: text
          });

          if (!response.ok) {
            const errorText = await response.text();
            console.error('API Error:', errorText);
            return [`Sorry, I couldn't process your request. Error: ${errorText || 'Unknown error.'}`];
          }

          const data = await response.text();

          if (data && data.trim()) {
            const suggestions = data.split('\n').map(s => s.trim()).filter(s => s);
            return suggestions;
          } else {
            return [`Sorry, I couldn't process your request.`];
          }
        } catch (error) {
          console.error('Fetch Error:', error);
          return [`Sorry, I couldn't process your request at the moment. Please try again later.`];
        }
      }

