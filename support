      /*---------------------------------------
       * Utility Functions
       ---------------------------------------*/
      function showLoader() {
        loaderScreen.style.display = "flex";
      }

      function hideLoader() {
        loaderScreen.style.display = "none";
      }

      function showValidationMessage(element, message, isSuccess) {
        element.textContent = message;
        if (isSuccess) {
          element.classList.add('success');
          element.classList.remove('error');
        } else {
          element.classList.add('error');
          element.classList.remove('success');
        }
        element.style.display = "block";
      }

      function hideValidationMessage(element) {
        element.textContent = "";
        element.classList.remove('success', 'error');
        element.style.display = "none";
      }

      /*---------------------------------------
       * AI Interaction Handlers
       ---------------------------------------*/
      // Show AI Interaction Screen
      function toggleAI() {
        showScreen(screens.ai);
      }

      // Handle AI Form Submission
      const aiForm = document.getElementById('ai-form');
      aiForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const query = document.getElementById('ai-query').value.trim();
        if (query === "") {
          showValidationMessage(notifications.aiResponse, "Please enter a question.", false);
          return;
        }
        notifications.aiResponse.classList.add('hidden');
        notifications.aiResponse.innerHTML = "";
        showLoader();

        try {
          const suggestions = await getAISuggestions(query);
          hideLoader();

          // Check for keywords to auto-navigate
          const autoNavigateKeywords = ["submit support ticket", "email"];
          const shouldAutoNavigate = suggestions.some(suggestion => 
            autoNavigateKeywords.some(keyword => suggestion.toLowerCase().includes(keyword))
          );

          if (shouldAutoNavigate) {
            showToast("Redirecting to Submit a Support Ticket...");
            showScreen(screens.support);
            return;
          }

          if (suggestions && suggestions.length > 0) {
            notifications.aiResponse.innerHTML = `<p>${suggestions.join('</p><p>')}</p>`;
          } else {
            notifications.aiResponse.innerHTML = `<p>Sorry, I couldn't find an answer to your question.</p>`;
          }
        } catch (error) {
          hideLoader();
          notifications.aiResponse.innerHTML = `<p>There was an error processing your request. Please try again later.</p>`;
          console.error('AI Request Error:', error);
        }

        notifications.aiResponse.classList.remove('hidden');
        aiForm.reset();
      });

